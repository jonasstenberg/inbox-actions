# IMAP Configuration
IMAP_SERVER=your-imap-server.com
IMAP_USERNAME=your-email@example.com
IMAP_PASSWORD=your-password

# AI Provider Configuration
# Default provider is Ollama (local). No API key required for local inference.

# Ollama (default) - Install from https://ollama.ai/
# Runs locally, no API key needed. Just run: ollama serve
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Cloud Providers (uncomment the one you want to use)

# Mistral - Get your API key at https://console.mistral.ai/
# MISTRAL_API_KEY=your-mistral-api-key

# OpenAI - Get your API key at https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-openai-api-key

# Anthropic - Get your API key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Google Gemini - Get your API key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key

# Optional: which mailbox folder to check (default: INBOX)
EMAIL_FOLDER=INBOX

# Optional: max emails to process per run (default: 10)
EMAIL_LIMIT=10

# Optional: fetch emails from last N days (default: 1)
EMAIL_DAYS=1

# Optional: max email size in bytes to process (default: 1048576 = 1MB)
# Emails larger than this will be skipped to avoid memory issues
# EMAIL_MAX_SIZE=1048576

# Timeouts (optional)
# LLM API timeout in seconds (default: 60)
# LLM_API_TIMEOUT=60

# Webhook notification timeout in seconds (default: 10)
# WEBHOOK_TIMEOUT=10

# Slack notifications (optional)
# Create a Slack app at https://api.slack.com/apps, add the chat:write scope,
# install to your workspace, and copy the Bot User OAuth Token.
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_CHANNEL=#general
