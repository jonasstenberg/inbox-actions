# IMAP Configuration
IMAP_SERVER=your-imap-server.com
IMAP_USERNAME=your-email@example.com
IMAP_PASSWORD=your-password

# Mistral API
MISTRAL_API_KEY=your-mistral-api-key

# Optional: which mailbox folder to check (default: INBOX)
EMAIL_FOLDER=INBOX

# Optional: max emails to process per run (default: 10)
EMAIL_LIMIT=10

# Optional: fetch emails from last N days (default: 1)
EMAIL_DAYS=1

# Slack notifications (optional)
# Create a Slack app at https://api.slack.com/apps, add the chat:write scope,
# install to your workspace, and copy the Bot User OAuth Token.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CHANNEL=#general
